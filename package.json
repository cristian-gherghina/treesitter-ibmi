{
  "name": "treesitter-ibmi",
  "private": true,
  "scripts": {
    "generate:dds-pf": "tree-sitter generate --abi 15 --output grammars/dds/pf/src grammars/dds/pf/grammar.js",
    "generate:dds-lf": "tree-sitter generate --abi 15 --output grammars/dds/lf/src grammars/dds/lf/grammar.js",
    "generate:dds-icff": "tree-sitter generate --abi 15 --output grammars/dds/icff/src grammars/dds/icff/grammar.js",
    "generate:dds-dspf": "tree-sitter generate --abi 15 --output grammars/dds/dspf/src grammars/dds/dspf/grammar.js",
    "generate:dds": "npm run generate:dds-pf && npm run generate:dds-lf && npm run generate:dds-icff && npm run generate:dds-dspf",
    "demo:nvim": "bash scripts/nvim-dds.sh pf",
    "demo:nvim:pf": "bash scripts/nvim-dds.sh pf",
    "demo:nvim:lf": "bash scripts/nvim-dds.sh lf",
    "demo:nvim:icff": "bash scripts/nvim-dds.sh icff",
    "demo:nvim:dspf": "bash scripts/nvim-dds.sh dspf",
    "test:dds-pf": "tree-sitter test -p grammars/dds/pf",
    "test:dds-lf": "tree-sitter test -p grammars/dds/lf",
    "test:dds-icff": "tree-sitter test -p grammars/dds/icff",
    "test:dds-dspf": "tree-sitter test -p grammars/dds/dspf",
    "test:fixtures:dds-pf": "node scripts/test-dds-fixtures.mjs pf",
    "test:fixtures:dds-lf": "node scripts/test-dds-fixtures.mjs lf",
    "test:fixtures:dds-icff": "node scripts/test-dds-fixtures.mjs icff",
    "test:fixtures:dds-dspf": "node scripts/test-dds-fixtures.mjs dspf",
    "test:queries:dds-pf": "tree-sitter query -p grammars/dds/pf grammars/dds/pf/queries/highlights.scm fixtures/dds-pf/alt-ext.dds",
    "check:generated": "npm run generate:dds && git diff --exit-code -- grammars/dds/pf/src grammars/dds/lf/src grammars/dds/icff/src grammars/dds/dspf/src",
    "test": "npm run test:dds-pf && npm run test:fixtures:dds-pf && npm run test:queries:dds-pf && npm run test:dds-lf && npm run test:fixtures:dds-lf && npm run test:dds-icff && npm run test:fixtures:dds-icff && npm run test:dds-dspf && npm run test:fixtures:dds-dspf"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.11"
  }
}
