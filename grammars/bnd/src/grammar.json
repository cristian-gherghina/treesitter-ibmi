{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "ibmi_bnd",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "export_block"
      }
    },
    "export_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "start_export_block"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "export_statement"
          }
        },
        {
          "type": "SYMBOL",
          "name": "end_export_block"
        }
      ]
    },
    "start_export_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "STRPGMEXP"
          },
          "named": true,
          "value": "keyword"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "program_level"
              },
              {
                "type": "SYMBOL",
                "name": "signature"
              },
              {
                "type": "SYMBOL",
                "name": "level_check"
              },
              {
                "type": "SYMBOL",
                "name": "parameter"
              }
            ]
          }
        }
      ]
    },
    "end_export_block": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "ENDPGMEXP"
      },
      "named": true,
      "value": "keyword"
    },
    "export_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "EXPORT"
          },
          "named": true,
          "value": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "symbol_parameter"
        }
      ]
    },
    "program_level": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "PGMLVL"
          },
          "named": true,
          "value": "parameter_name"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "*CURRENT"
              },
              {
                "type": "STRING",
                "value": "*PRV"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "signature": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "SIGNATURE"
          },
          "named": true,
          "value": "parameter_name"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "*GEN"
              },
              {
                "type": "SYMBOL",
                "name": "string"
              },
              {
                "type": "SYMBOL",
                "name": "hex_string"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "level_check": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "LVLCHK"
          },
          "named": true,
          "value": "parameter_name"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "*YES"
              },
              {
                "type": "STRING",
                "value": "*NO"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "symbol_parameter": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "SYMBOL"
          },
          "named": true,
          "value": "parameter_name"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "symbol",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "string"
              },
              {
                "type": "SYMBOL",
                "name": "identifier"
              },
              {
                "type": "SYMBOL",
                "name": "wildcard_symbol"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "parameter": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "FIELD",
            "name": "value",
            "content": {
              "type": "SYMBOL",
              "name": "_value"
            }
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "hex_string"
        },
        {
          "type": "SYMBOL",
          "name": "special_value"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "wildcard_symbol": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "<<<"
          },
          {
            "type": "PATTERN",
            "value": "[A-Za-z0-9_#$@§]*<<<[A-Za-z0-9_#$@§<>]*"
          },
          {
            "type": "PATTERN",
            "value": "[A-Za-z0-9_#$@§]+>>>[A-Za-z0-9_#$@§<>]*"
          }
        ]
      }
    },
    "identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[A-Za-z_#$@§][A-Za-z0-9_#$@§]*"
      }
    },
    "special_value": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\*[A-Z0-9_]+"
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[0-9]+(\\.[0-9]+)?"
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "'([^'\\r\\n]|'')*'"
      }
    },
    "hex_string": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[Xx]'([0-9A-Fa-f]{2})*'"
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "/*"
              },
              {
                "type": "PATTERN",
                "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
              },
              {
                "type": "STRING",
                "value": "/"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "--"
              },
              {
                "type": "PATTERN",
                "value": "[^\\r\\n]*"
              }
            ]
          }
        ]
      }
    },
    "_line_continuation": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "+"
          },
          {
            "type": "PATTERN",
            "value": "[ \\t]*\\r?\\n"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    },
    {
      "type": "SYMBOL",
      "name": "_line_continuation"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}